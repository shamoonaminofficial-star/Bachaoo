# Bachatly — environment template
# NEVER expose server secrets to frontend — only NEXT_PUBLIC_* vars are public.
# Copy: cp .env.example .env, then fill the blanks.

# ---------------------------------------------------------------- App identity
APP_NAME=Bachatly
APP_TAGLINE="Save More. Live More."
CURRENCY=PKR # Money is stored as integer paisa everywhere; display as "Rs."
TIMEZONE=Asia/Karachi
DEFAULT_COUNTRY=PK

# ---------------------------------------------------------------- Database / cache
DATABASE_URL=postgresql://bachatly:bachatly@localhost:5432/bachatly
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------- Auth (JWT) — server-only secrets
JWT_SECRET= # min 32 chars
JWT_REFRESH_SECRET= # min 32 chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ---------------------------------------------------------------- QR redemption
# 60–120, short-lived redemption token
QR_TOKEN_TTL_SECONDS=90

# ---------------------------------------------------------------- Web / API
NEXT_PUBLIC_SITE_URL=http://localhost:3000
PORT=4000
CORS_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------- Maps — SERVER-ONLY, never NEXT_PUBLIC
GOOGLE_MAPS_API_KEY=
# public, restricted key — safe to ship in the browser
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ---------------------------------------------------------------- Email — server-only
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD= # server-only
EMAIL_FROM=hello@bachatly.pk
# EMAIL_SECURE=true  # set true for port 465 (implicit TLS); defaults to false for 587 (STARTTLS)
# SMS / WhatsApp provider wiring (auth channels are ready-stubs until configured):
# SMS_PROVIDER=
# SMS_PROVIDER_KEY=
# WHATSAPP_PROVIDER=
# WHATSAPP_PROVIDER_KEY=

# ---------------------------------------------------------------- Messaging — server-only
SMS_PROVIDER_KEY= # server-only, SMS-ready
WHATSAPP_PROVIDER_KEY= # server-only, WhatsApp-ready

# ---------------------------------------------------------------- Object storage (MinIO local / S3 prod)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=
S3_SECRET_KEY= # server-only
S3_BUCKET=bachatly
S3_REGION=us-east-1

# ---------------------------------------------------------------- Payments
ACTIVE_PAYMENT_GATEWAY=MANUAL # STRIPE | JAZZCASH | EASYPASA | BANK_TRANSFER | MANUAL
PAYMENT_GATEWAY_KEY=
PAYMENT_GATEWAY_SECRET= # server-only

# JazzCash
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_RETURN_URL=

# Easypaisa
EASYPASA_STORE_ID=
EASYPASA_HASH_KEY=

# Manual bank transfer
BANK_NAME=
BANK_ACCOUNT_TITLE=
BANK_IBAN=
