# Public (safe to expose to the browser)
NEXT_PUBLIC_SITE_URL=https://bachatly.pk
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Server-only — never prefix secrets with NEXT_PUBLIC_
# JWT_SECRET must match the backend API's JWT_SECRET: the edge middleware
# verifies the access-token signature with it (via `jose`).
JWT_SECRET=dev-secret-change-me
# Optional: internal URL for server-side API calls (defaults to NEXT_PUBLIC_API_URL)
# API_URL_INTERNAL=http://api:4000
# API keys live in the backend; listed here for documentation only
# PAYMENT_GATEWAY_KEY=
# PAYMENT_GATEWAY_SECRET=
