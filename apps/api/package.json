{
  "dependencies": {
    "@bachatly/config": "workspace:*",
    "@bachatly/database": "workspace:*",
    "@bachatly/types": "workspace:*",
    "@bachatly/validation": "workspace:*",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/schedule": "^5.0.0",
    "@nestjs/swagger": "^11.0.0",
    "@nestjs/throttler": "^6.2.0",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.6",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^6.9.14",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "uuid": "^11.0.0"
  },
  "description": "Bachatly API \u2014 Save More. Live More. (NestJS, /api/v1)",
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/jest": "^29.5.14",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^6.4.15",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.0",
    "typescript": "^5.7.0",
    "@types/jsonwebtoken": "^9.0.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "moduleNameMapper": {
      "^@bachatly/([a-z-]+)$": "<rootDir>/../../packages/$1/src"
    },
    "rootDir": ".",
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/src/**/*.spec.ts",
      "<rootDir>/test/**/*.spec.ts",
      "<rootDir>/test/**/*.e2e-spec.ts"
    ],
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    }
  },
  "license": "UNLICENSED",
  "name": "bachatly-api",
  "private": true,
  "scripts": {
    "build": "nest build",
    "lint": "tsc --noEmit",
    "start": "node dist/apps/api/src/main",
    "start:dev": "nest start --watch",
    "test": "jest",
    "test:e2e": "jest --runInBand test/"
  },
  "version": "1.0.0"
}
